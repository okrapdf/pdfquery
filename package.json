{
  "name": "pdfquery",
  "version": "0.3.2",
  "description": "Query native tagged-PDF structure from the command line",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pdfquery": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "install.sh",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "CHANGELOG.md",
    "divergence.md"
  ],
  "engines": {
    "node": ">=20.16.0 || >=22.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okrapdf/pdfquery.git"
  },
  "homepage": "https://github.com/okrapdf/pdfquery#readme",
  "bugs": {
    "url": "https://github.com/okrapdf/pdfquery/issues"
  },
  "keywords": [
    "pdf",
    "query",
    "cli",
    "tagged-pdf",
    "accessibility",
    "structtree"
  ],
  "dependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build:native --silent && vitest run",
    "test:contract": "npm run build:native --silent && vitest run src/__tests__/cli-json-contract.test.ts",
    "build:native": "node scripts/build-native.mjs",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && npm run build:native",
    "benchmark": "node --expose-gc benchmarks/run.mjs --quick",
    "benchmark:full": "node --expose-gc benchmarks/run.mjs",
    "benchmark:prepare": "node benchmarks/prepare-baseline.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:package": "npm run build && npm run check:dist && node scripts/test-package.mjs",
    "test:install": "sh -n install.sh",
    "test:acceptance:syntax": "sh -n scripts/acceptance.sh",
    "prepack": "npm run build && npm run check:dist",
    "size": "gzip -c dist/index.js | wc -c"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
